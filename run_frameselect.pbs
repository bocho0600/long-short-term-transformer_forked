#!/bin/bash -l
#PBS -N classic
#PBS -l select=1:ncpus=4:ngpus=1:mem=32GB:gpu_id=A100
#PBS -l walltime=24:00:00
#PBS -m abe
#PBS -M n11429984@qut.edu.au
#PBS -j oe
#PBS -q gpu_batch_exec

# ── Paths ────────────────────────────────────────────────────────────────────
REPO_DIR=~/long-short-term-transformer_forked
HPC_RUN_DIR=~/hpc_run

CONFIG=configs/THUMOS/LSTR/lstr_long_512_work_8_kinetics_1x_frameselect.yaml
CKPT=checkpoints/THUMOS/LSTR/lstr_long_512_work_8_kinetics_1x_frameselect/epoch-25.pth

# ── Run training ─────────────────────────────────────────────────────────────
cd "$REPO_DIR"

module load Miniconda3
conda activate lstr

export PYTHONPATH=$PYTHONPATH:$(pwd)/src

python tools/train_net.py \
    --config_file "$CONFIG" \
    --gpu 0

TRAIN_EXIT=$?

# ── Evaluate the trained checkpoint + FLOP measurement ───────────────────────
if [ $TRAIN_EXIT -eq 0 ]; then
    # NOTE: batch inference uses batch = DATA_LOADER.BATCH_SIZE * 16 windows.
    # With BATCH_SIZE 16 (=256) and 8 workers this OOM-kills the loader on a
    # 4-CPU/32GB node. Lower the batch and workers for eval.
    python tools/test_net.py \
        --config_file "$CONFIG" \
        --gpu 0 \
        MODEL.CHECKPOINT "$CKPT" \
        DATA_LOADER.BATCH_SIZE 4 \
        DATA_LOADER.NUM_WORKERS 4 \
        DATA_LOADER.PIN_MEMORY False

    python tools/flop_frame_selection.py \
        --config_file "$CONFIG" \
        --epochs 25 --test_iters 354
else
    echo "Training failed (exit $TRAIN_EXIT); skipping eval and FLOPs."
fi

# ── Git commit (always) and push (best-effort) ───────────────────────────────
cd "$HPC_RUN_DIR"
git add logs/
git commit -m "logs: $(date +"%Y-%m-%d_%H-%M-%S") job=${PBS_JOBID} exit=${TRAIN_EXIT}"

if git push origin main; then
    echo "Logs pushed to GitHub."
else
    echo "WARNING: git push failed (compute node likely can't reach github.com)."
    echo "         The commit is saved locally in ${HPC_RUN_DIR}."
    echo "         Push it from the login node with:  cd ${HPC_RUN_DIR} && git push origin main"
    touch "${HPC_RUN_DIR}/.push_pending"
fi

# Exit with the TRAINING result, not the push result.
exit $TRAIN_EXIT
